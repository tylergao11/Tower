{
  "name": "tower",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node tools/configure-art.mjs && node tools/measure-characters.mjs",
    "build": "tsc --noEmit && vite build",
    "art:build": "node tools/prepare-art.mjs && node tools/pack-ui-redraw.mjs && node tools/pack-noncharacter-redraw.mjs && node tools/configure-art.mjs && node tools/prune-runtime-art.mjs",
    "art:clean": "node tools/prune-runtime-art.mjs",
    "art:configure": "node tools/configure-art.mjs && node tools/measure-characters.mjs",
    "art:preview": "node tools/serve-art.mjs",
    "art:check-characters": "node tools/check-character-art.mjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@types/node": "25.5.0",
    "sharp": "^0.35.4",
    "typescript": "6.0.2",
    "vite": "8.3.0"
  }
}
